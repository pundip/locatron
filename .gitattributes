# Line endings. Development on Windows, deployment on Debian.
# Without this, shell scripts check out with CRLF and bash on the
# container fails with "bad interpreter: /usr/bin/env bash^M".

* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.timer   text eol=lf
.env.example text eol=lf

scripts/git-hooks/pre-commit text eol=lf

# Windows-only files keep CRLF.
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary.
*.png     binary
*.jpg     binary
*.zip     binary
*.parquet binary
*.sqlite  binary
