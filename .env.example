# Locatron configuration. Copy to the real env file and fill in the secrets.
#
#   container:  /opt/locatron/.env          owned by locatron, mode 600
#   dev:        .env in the repo root       never committed
#
# deploy/install.sh copies this file into place on a fresh container. Every
# setting below is read as LOCATRON_<NAME> by locatron/config.py, so anything
# left commented out falls back to the default in that file.

# --- MySQL ------------------------------------------------------------------
# The service account. SELECT everywhere, writes only to locatron_unresolved and
# locatron_api_key. Gazetteer rebuilds use locatron_build instead; see
# sql/grants.sql.
LOCATRON_MYSQL_HOST=pundip.com
LOCATRON_MYSQL_PORT=3335
LOCATRON_MYSQL_USER=locatron
LOCATRON_MYSQL_PASSWORD=CHANGE_ME
LOCATRON_MYSQL_DATABASE=ReferenceDB

# --- Local SQLite street mirror ---------------------------------------------
# Built by `locatron build streets`, about 55 MB for 532k rows.
#
# MUST be an absolute path outside the git checkout on the container. Inside it,
# deploy.sh's `git reset --hard` would delete the mirror on every deploy, and the
# workers would then refuse to start.
#
# A relative path is resolved against the repo root rather than the working
# directory, so it behaves the same whichever directory a command runs from. That
# is for development only; production sets the absolute form.
LOCATRON_SQLITE_PATH=/opt/locatron/data/gazetteer.sqlite
# dev on Windows or macOS:
# LOCATRON_SQLITE_PATH=./data/gazetteer.sqlite

# --- Redis ------------------------------------------------------------------
# Result cache only. Losing it must cost latency, never correctness.
LOCATRON_REDIS_URL=redis://127.0.0.1:6379/0
# LOCATRON_CACHE_ENABLED=true

# --- Paths and serving ------------------------------------------------------
# LOCATRON_DATA_DIR=/var/lib/locatron
# Public URL is urlloom.com/locatron, so the apps mount under that prefix.
# LOCATRON_ROOT_PATH=/locatron
# LOCATRON_LOG_LEVEL=INFO

# --- Resolution tuning ------------------------------------------------------
# Applied only to separate near-equal candidates, never to override a country
# stated explicitly in the input.
# LOCATRON_COUNTRY_BIAS=AUS
# LOCATRON_FUZZY_LOCALITY_MIN=88
# LOCATRON_FUZZY_CITY_MIN=90
# LOCATRON_FUZZY_STREET_MIN=85
